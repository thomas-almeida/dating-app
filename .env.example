# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# Supabase: Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só no servidor. Dá acesso total ao banco. Aceita a secret key (sb_secret_...) ou a service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço público do app, sem barra no final. Vai nos links de convite e no retorno do checkout.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AbacatePay. Sem esses valores, a tela do Pro mostra as assinaturas como indisponíveis.
# A chave precisa da permissão SUBSCRIPTION:DELETE para o cancelamento funcionar.
ABACATEPAY_API_KEY=
# Produto mensal criado na loja do AbacatePay.
ABACATEPAY_PRO_PRODUCT_ID=
# Secret do webhook. Use o mesmo valor em ?webhookSecret= na URL cadastrada.
ABACATEPAY_WEBHOOK_SECRET=

# Notificações. Gere com `npx web-push generate-vapid-keys`. Sem elas, o app não oferece notificações.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato para os serviços de push, no formato mailto:voce@exemplo.com
VAPID_SUBJECT=
