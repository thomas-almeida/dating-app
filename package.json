{
  "name": "datingapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "tsx --conditions=react-server --test tests/unit/*.test.ts",
    "test:db": "tsx scripts/test-migration.ts",
    "test:e2e": "node tests/e2e/run.mjs",
    "admin:create": "tsx --env-file=.env.local scripts/create-admin.ts",
    "seed:demo": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "seed:bots": "tsx --env-file=.env.local scripts/seed-bots.ts",
    "icons": "tsx scripts/generate-icons.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
